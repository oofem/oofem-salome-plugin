        {"key": "Values", "name": "Values", "type": "floatarray", "default": "", "description": "Prescribed DOF values."}
      ]
    },
    {
      "oofem_name": "NodalLoad",
      "display_name": "Nodal Load/Flux",
      "apply_to": "nodes",
      "params": [
        {"key": "DOFs", "name": "DOFs", "type": "intarray", "default": "", "description": "Degree of freedom (1=x, 2=y, 3=z)."},
        {"key": "Components", "name": "Components", "type": "floatarray", "default": "", "description": "Nodal Load/Flux DOF values."}
      ]
    },
    {
      "oofem_name": "ConstantEdgeLoad",
      "display_name": "Constant Edge Load (on Element Boundary)",
      "apply_to": "elementedges",
      "params": [
        {"key": "DOFs", "name": "DOFs", "type": "intarray", "default": "", "description": "Degree of freedom (D_u(1), D_v(2), D_w(3)=y)."},
        {"key": "Components", "name": "Components", "type": "floatarray", "default": "", "description": "Load components in the specified DOFs."},
        {"key": "loadtype", "name": "LoadType", "type": "int", "default": "3", "description": "Type of load (e.g., pressure, traction)."},
        {"key": "csType", "name": "cstype", "type": "int", "default": 0, "description": "The load can be defined in global coordinate system (csType = 0, default) or in entity - specific local coordinate system (csType = 1)."}
